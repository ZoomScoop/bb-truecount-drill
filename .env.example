# Passcode gate
APP_PASSCODE=choose-a-passcode
AUTH_SECRET=choose-a-long-random-string

# Anthropic (card identification via Claude vision)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (free project at supabase.com) - both are SAFE to expose to the
# browser; data is protected by the cards table policy, not by key secrecy.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
